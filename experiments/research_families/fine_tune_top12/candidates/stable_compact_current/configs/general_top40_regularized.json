{
  "profile": "general",
  "target": "target_excess_5d",
  "target_horizon_days": 5,
  "selected_features_path": "experiments/feature_selection/general/selected_features.txt",
  "split": {
    "holdout_test_days": 10,
    "portfolio_validation_days": 8,
    "train_lookback_days": null,
    "validation_days": 20,
    "embargo_days": 5,
    "min_valid_stocks_per_date": 100
  },
  "train": {
    "refit_on_full_known_data": true
  },
  "model": {
    "type": "xgb_regressor",
    "params": {
      "n_estimators": 500,
      "max_depth": 3,
      "learning_rate": 0.035,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 34,
      "reg_lambda": 11.2,
      "reg_alpha": 0.05,
      "objective": "reg:squarederror",
      "eval_metric": "rmse",
      "tree_method": "hist",
      "random_state": 2601,
      "n_jobs": -1
    },
    "early_stopping_rounds": 40
  }
}
