{
  "profile": "general",
  "target": "target_excess_5d",
  "auxiliary_targets": ["target_rank_5d"],
  "test_trading_days": 10,
  "split": {
    "mode": "rolling_walk_forward",
    "train_lookback_days": null,
    "min_train_days": 160,
    "validation_days": 20,
    "step_days": 20,
    "embargo_days": 5,
    "max_folds": 6,
    "min_valid_stocks_per_date": 100
  },
  "candidate_groups": [
    "baseline_technical",
    "csi500_relative",
    "bollinger",
    "liquidity_risk",
    "cross_sectional",
    "market_regime",
    "industry_relative",
    "valuation",
    "quality"
  ],
  "base_groups": [
    "baseline_technical",
    "csi500_relative",
    "liquidity_risk",
    "cross_sectional"
  ],
  "single_factor": {
    "quantile": 0.1,
    "max_missing_rate": 0.35,
    "min_valid_stocks_per_date": 100
  },
  "model": {
    "top_k": 60,
    "ridge_alpha": 10.0,
    "ablation_top_features": 140,
    "xgb_enabled": true,
    "xgb_top_features": 80,
    "xgb_params": {
      "n_estimators": 160,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 20,
      "reg_lambda": 5.0,
      "objective": "reg:squarederror",
      "tree_method": "hist",
      "random_state": 2601,
      "n_jobs": -1
    }
  },
  "selection": {
    "max_features": 120,
    "min_features": 40,
    "top_features_per_group": 8,
    "weights": {
      "rank_ic_stability": 0.30,
      "top_decile_excess": 0.20,
      "group_ablation": 0.25,
      "worst_window": 0.15,
      "missing_penalty": 0.10
    }
  }
}
